{
  "name": "wantok-ride",
  "private": true,
  "version": "1.0.0",
  "description": "Wantok Ride \u2014 passenger/vehicle marketplace for Port Moresby. Skyworks Systems.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspace @wantok/core",
    "mobile": "npm start --workspace @wantok/mobile",
    "admin": "npm run dev --workspace @wantok/admin",
    "sync:core": "node scripts/sync-core.mjs",
    "db:reset": "supabase db reset",
    "functions:deploy": "npm run sync:core && supabase functions deploy",
    "build:deploy": "node scripts/build-deploy-sql.mjs",
    "test:db": "bash scripts/test-db.sh"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
