# Wantok Ride — mobile app configuration
#
# Copy to .env for local development. For builds, set these in the EAS build
# profile instead — .env is gitignored and will not reach a release APK.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the bundle and is therefore
# public. That is correct for the Supabase anon key (row-level security is what
# protects the data) and unavoidable for the Google Maps key. It is NEVER
# correct for a Supabase service role key — there is no code path in this app
# that accepts one.

# --- Supabase --------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google Maps Platform --------------------------------------------------
# Enable: Directions API, Geocoding API, Places API, Maps SDK for Android.
# Restrict the key to this app's package name + SHA-1, and set a daily quota
# cap before the first APK ships (spec §13, rule 7).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-maps-key

# --- Variant ---------------------------------------------------------------
# 'customer' or 'driver'. Two Play Store listings from this one codebase.
EXPO_PUBLIC_VARIANT=customer

# --- Endpoints -------------------------------------------------------------
EXPO_PUBLIC_TRACK_URL=https://track.wantokride.com
EXPO_PUBLIC_SUPPORT_PHONE=+67570000000
