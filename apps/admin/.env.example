# Wantok Ride admin console
#
# The anon key only. Admin powers come from the signed-in user's role and the
# RLS policies in 0003_rls.sql — NOT from a privileged key in the browser.
# A service role key here would hand every licence and NID number in the
# database to anyone who opened dev tools.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
